{
	"schemaVersion": 1,
	"id": "poweredtools",
	"version": "${version}",
	"name": "PoweredTools",
	"description": "A Mod centered around using batteries for your tools",
	"authors": [
    "Me! (Acidicts)"
  ],
  "contact": {
    "sources": "https://github.com/Acidicts/Powered-Tools-Minecraft-Mods"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.acidicts.poweredtools.PoweredTools"
    ],
    "client": [
      "net.acidicts.poweredtools.PoweredToolsClient"
    ],
    "fabric-datagen": [
      "net.acidicts.poweredtools.PoweredToolsDataGenerator"
    ],
    "rei_client": [
        "net.acidicts.poweredtools.compat.PoweredToolsModREIClient"
    ]
  },
  "mixins": [
    "poweredtools.mixins.json"
  ],
  "depends": {
    "geckolib": ">=4.7.0",
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}